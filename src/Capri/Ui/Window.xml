<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 Title="Capri" Width="260" Height="430" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
 ShowActivated="False">
 <Grid Name="Scene" Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Ellipse Grid.Row="1" Name="Shadow" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Width="80" Height="12">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#C0000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Image Grid.Row="1" Name="Sprite" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
   <Image.RenderTransform><TransformGroup>
    <ScaleTransform/><RotateTransform/><TranslateTransform/>
   </TransformGroup></Image.RenderTransform>
  </Image>
  <Image Grid.Row="1" Name="Ghost" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Collapsed"/>
  <Canvas Name="Blackwall" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True"/>
  <Border Name="SabotagePanel" Grid.Row="1" VerticalAlignment="Top" Background="#E510070C" BorderBrush="#D02246" BorderThickness="1" Padding="8" Visibility="Collapsed" IsHitTestVisible="False">
   <TextBlock Name="SabotageText" Foreground="#FF4564" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="SIGNAL LOST"/>
  </Border>
  <Border Name="FocusBadge" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#E5070A12" BorderBrush="#FCEE0A" BorderThickness="1" Padding="6,1" Margin="0,0,0,2" Visibility="Collapsed" IsHitTestVisible="False">
   <TextBlock Name="FocusText" Foreground="#FCEE0A" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
  </Border>
  <TextBlock Name="Effect" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#FF75D6" FontFamily="Segoe UI Symbol" FontSize="24" IsHitTestVisible="False"/>
  <Border Grid.Row="0" Name="Bubble" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="{Binding ActualWidth, ElementName=Scene}" Margin="6,0,6,6" IsHitTestVisible="False"
   Background="Transparent" BorderThickness="0" Visibility="Collapsed">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/></Grid.RowDefinitions>
    <!-- cut-corner panel with a cyan wire edge, a pink rail and a little tail pointing at her -->
    <Canvas ClipToBounds="False">
    <Path Name="BubbleFrame" Stretch="None" Fill="#F20A0F18" Stroke="#3FE6F5" StrokeThickness="1.4">
     <Path.Effect><DropShadowEffect Color="#3FE6F5" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/></Path.Effect>
    </Path>
    </Canvas>
    <Path Grid.Row="1" HorizontalAlignment="Center" Margin="40,-2,0,0" Data="M0,0 L16,0 L4,12 Z" Fill="#F20A0F18" Stroke="#3FE6F5" StrokeThickness="1.4"/>
    <Rectangle Width="3" HorizontalAlignment="Left" Margin="7,9,0,9" Fill="#FF2A6D"/>
    <StackPanel Margin="17,7,12,9">
     <DockPanel LastChildFill="False" Margin="0,0,0,2">
      <TextBlock Name="BubbleTag" DockPanel.Dock="Left" Text="CAPRI:" Foreground="#FF2A6D" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
      <TextBlock DockPanel.Dock="Right" Text="// live" Foreground="#5B6B88" FontFamily="Consolas" FontSize="10"/>
     </DockPanel>
     <TextBlock Name="Words" Foreground="#5EF0FA" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" TextAlignment="Left"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
