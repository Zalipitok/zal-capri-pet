  "_fields": {
    "id": "State name. A matching entry in the $motions table of Capri.ps1 adds custom animation (or set 'motion' to share one).",
    "title / menu": "Menu label and the Animations submenu it appears in (omit menu to keep it out of the menu).",
    "auto / rare": "auto = part of the random rotation; rare = drawn from the rare-antics timer instead.",
    "category": "attacks | wandering | resting | antics. Drives the Activity frequency sliders (default antics).",
    "pose / poses / loop": "One sprite index, or a timeline [[pose, seconds], ...]; the last step can omit seconds. loop repeats it.",
    "seconds": "Duration: a number, or [min, max] for a random whole number of seconds (default [5, 10]).",
    "target": "random (default) | bottom | taskbar | edge | cursor | cursorAnchor | otherMonitor | window.",
    "path / speed / clampTarget": "Per-frame target updater from the $paths table, travel speed (omit to stay put), keep target on screen.",
    "next / nextNoChase / setMood": "State to go to afterwards (default: pick something new). nextNoChase applies when cursor chasing is off. '@attack' resolves the pounce.",
